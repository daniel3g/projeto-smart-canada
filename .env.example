# Template das variáveis da aplicação web.
# Copie para web/.env.local e preencha. Nunca versione o arquivo preenchido.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role ignora RLS. Só no servidor: nunca no navegador, nunca no firmware.
SUPABASE_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_NAME=ESP32 IoT Dashboard
NEXT_PUBLIC_DEFAULT_DEVICE_KEY=esp32-city-01

# Usado apenas por scripts/promote-admin.mjs --create, em ambiente local.
ADMIN_SEED_PASSWORD=
